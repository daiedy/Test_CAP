{
  "mcpServers": {
    "cds-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@cap-js/mcp-server@0.0.5"]
    },
    "fiori-mcp": {
      "type": "stdio",
      "timeout": 600,
      "command": "npx",
      "args": ["--yes", "@sap-ux/fiori-mcp-server@1.12.2", "fiori-mcp"],
      "env": { "SAP_UX_FIORI_TOOLS_DISABLE_TELEMETRY": "true" }
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.8.0"]
    }
  }
}
