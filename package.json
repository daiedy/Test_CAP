{
  "name": "product-catalog",
  "version": "1.0.0",
  "description": "SAP CAP Product Catalog Application",
  "repository": "https://github.com/daiedy/Test_CAP",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@sap/cds": "^10",
    "@sap/cds-common-content": "^3.2.0",
    "express": "^5",
    "read-excel-file": "^9.3.12"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/openapi": "1.6.0",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "@sap/eslint-plugin-cds": "^4",
    "@sap/ux-specification": "^1.144.12",
    "@vitest/coverage-v8": "^5",
    "cds-swagger-ui-express": "^0.11.0",
    "eslint": "^10",
    "eslint-plugin-jsdoc": "^65.4.2",
    "prettier": "^3",
    "vitest": "^5",
    "write-excel-file": "^4.1.1"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "cds build --production",
    "deploy": "cds deploy",
    "test": "vitest run --silent",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "cds lint",
    "lint:js": "eslint .",
    "format": "prettier --write --no-error-on-unmatched-pattern \"srv/**/*.js\" \"test/**/*.js\" \"scripts/**/*.mjs\"",
    "docs:registry": "node scripts/gen-registry.mjs",
    "docs:api": "node scripts/gen-api-docs.mjs",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"srv/**/*.js\" \"test/**/*.js\" \"scripts/**/*.mjs\""
  },
  "cds": {
    "cdsc": {
      "docs": true
    },
    "requires": {
      "auth": {
        "users": {
          "alice": { "roles": ["CatalogEditor"] },
          "bob": { "roles": ["CatalogEditor"] },
          "viewer": { "roles": ["CatalogViewer"] }
        }
      }
    }
  },
  "sapux": [
    "app/products"
  ],
  "scarfSettings": {
    "enabled": false
  }
}
