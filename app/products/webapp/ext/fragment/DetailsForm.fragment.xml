<!--
    Custom section "Details" of the product Object Page (ADR-0027 decision 5), added through Fiori MCP after PricingStock.
    One FormContainer whose form elements DetailsForm.js builds per detail row (its createFormElement factory) and keeps
    across changes of the details binding; rows come in the server's position order only (no client sorter). Edit state from the Fiori elements model ui>/isEditable; the
    side effect #SubcategoryChanged (TargetEntities details) re-reads this binding after the server reconciles the rows.
    The selections of a MULTI_LIST row are not expanded here: each multi combo box reads them with its own request
    (ADR-0027 amendment, ruling B7). subcategory_code is a string code, so the visible expressions use targetType any.
-->
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
>
    <VBox
        id="detailsFormBox"
        core:require="{ DetailsForm: 'products/ext/fragment/DetailsForm' }"
        app:detailsRole="root"
        modelContextChange="DetailsForm.onModelContextChange"
    >
        <core:InvisibleText id="detailsFormTitle" text="{i18n>ProductsObjectPage.details.title}" />
        <!-- the counter "Filled N of M" (SCREENS "Title, counter, layout"): an inverted status, Success when every field is
             filled, Warning otherwise; DetailsForm.js sets its text, state, icon (counterStatus) and visibility.
             alignSelf Start keeps the badge as wide as its text, not as wide as the card -->
        <ObjectStatus id="detailsCounter" app:detailsRole="counter" inverted="true" visible="false">
            <layoutData>
                <FlexItemData alignSelf="Start" />
            </layoutData>
        </ObjectStatus>
        <Text
            id="detailsNoSubcategory"
            text="{i18n>ProductsObjectPage.details.noSubcategory}"
            visible="{= !${path: 'subcategory_code', targetType: 'any'} &amp;&amp; ${ui>/isEditable} !== true }"
        />
        <Text
            id="detailsSelectSubcategory"
            text="{i18n>ProductsObjectPage.details.selectSubcategory}"
            visible="{= !${path: 'subcategory_code', targetType: 'any'} &amp;&amp; ${ui>/isEditable} === true }"
        />
        <Text
            id="detailsNoAttributes"
            app:detailsRole="noAttributes"
            text="{i18n>ProductsObjectPage.details.noAttributes}"
            visible="false"
        />
        <form:Form
            id="detailsForm"
            app:detailsRole="form"
            editable="{= ${ui>/isEditable} === true }"
            ariaLabelledBy="detailsFormTitle"
            visible="{= !!${path: 'subcategory_code', targetType: 'any'} }"
        >
            <form:layout>
                <!-- the layout of the Fiori elements form sections (sap.fe.macros.Form default), so the fields share their column grid -->
                <form:ColumnLayout columnsXL="6" columnsL="4" columnsM="3" labelCellsLarge="12" />
            </form:layout>
            <form:formContainers>
                <!-- the rows are bound in the non-rendered dependents; DetailsForm.js keeps one form element per row
                     context, so a details change keeps the controls (and the focus) of the rows that stay.
                     $$ownRequest: a dependent list binding without its own cache is refreshed by the OData model after
                     every side-effect request of the product (ODataContextBinding#requestSideEffects ends with
                     refreshDependentListBindingsWithoutCache), also after each DraftMessages read; with its own cache
                     the rows are refreshed only by a side effect that names details (#SubcategoryChanged, the module's
                     Edit re-read of ruling B2) or read again for a new product context (Edit, Save, Discard) -->
                <form:FormContainer
                    id="detailsFormContainer"
                    dependents="{
                        path: 'details',
                        parameters: {
                            $$ownRequest: true,
                            $select: 'ID,IsActiveEntity,position,textValue,numberValue,listValue_code',
                            $expand: 'attribute($select=code,name,unit,valueType_code,minValue,maxValue,scale;$expand=values($select=code,name,position;$orderby=position))',
                            $orderby: 'position'
                        }
                    }"
                >
                    <form:dependents>
                        <core:Item key="{ID}" />
                    </form:dependents>
                </form:FormContainer>
            </form:formContainers>
        </form:Form>
    </VBox>
</core:FragmentDefinition>
