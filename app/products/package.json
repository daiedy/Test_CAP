{
  "name": "products",
  "version": "0.0.1",
  "description": "Product Catalog Fiori Application",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "scripts": {
    "start": "fiori run --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#products-display\"",
    "start-mock": "fiori run --config ./ui5-mock.yaml --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#products-display\"",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "build:cf": "ui5 build preload --clean-dest --config ui5-deploy.yaml --include-task=generateCachebusterInfo",
    "lint": "ui5lint",
    "lint:fix": "ui5lint --fix"
  },
  "devDependencies": {
    "@sap-ux/eslint-plugin-fiori-tools": "^10",
    "@sap-ux/ui5-middleware-fe-mockserver": "^2",
    "@sap/ux-ui5-tooling": "^1.32.0",
    "@ui5/cli": "^4",
    "@ui5/linter": "^1"
  },
  "ui5": {
    "dependencies": [
      "@sap/ux-ui5-tooling",
      "@sap-ux/ui5-middleware-fe-mockserver"
    ]
  }
}
